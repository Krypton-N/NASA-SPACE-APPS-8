# /etc/flame/flame.env — ajustes del servicio, SIN secretos (bootstrap.sh lo copia si no existe).
# Las llaves (NVIDIA_API_KEY) van aparte en /opt/flame/research/.env, con modo 600 y dueño flame.

PYTHONUTF8=1

# Obligatorio: boto3 no toma la región del rol de la instancia y, sin esto, Bedrock aparece "no disponible".
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# "nvidia" activa el selector de modelos: Bedrock (por el rol IAM de la EC2) y la API de NVIDIA.
NASA_SCIENTIFIC_LLM_PROVIDER=nvidia
NASA_DEFAULT_MODEL=nvidia.nemotron-super-3-120b

# Carga el motor al arrancar (~20 s) en vez de en la primera pregunta.
NASA_WARMUP=1

# Hilos del verificador NLI local. Por defecto vCPU - 1 (máximo 8).
# NASA_NLI_THREADS=

# Ocultar modelos caros en la demo (IDs separados por coma), por ejemplo:
# NASA_HIDDEN_MODELS=us.anthropic.claude-opus-4-6-v1,us.anthropic.claude-sonnet-4-6
